// Scalar values, slices, mutable lists, pairs, and dictionaries.

let language = 'Tapas'
var numbers = [1, 2, 3]
numbers.append(4)

let profile = {
    'name' : 'Ada',
    'score' : 9.5,
}
let tagged = 'language' : language

print(language[0:3])
pprint(numbers)
print(profile::name)
print(profile['score'])
print(tagged[0], ': ', tagged[1])

let changed = numbers.copy()
changed[0] = 10
pprint(numbers)
pprint(changed)
