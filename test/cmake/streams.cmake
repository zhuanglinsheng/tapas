if(NOT DEFINED TAPAS OR NOT DEFINED WORK_DIR)
    message(FATAL_ERROR "TAPAS and WORK_DIR are required")
endif()
file(MAKE_DIRECTORY "${WORK_DIR}")
file(WRITE "${WORK_DIR}/streams.tap" [=[io::write('out')
io::write_error('err')
io::flush()
io::flush('stderr')
assert(rule { not io::is_terminal('stdout') and not io::is_terminal('stderr') })
]=])
execute_process(COMMAND "${TAPAS}" "${WORK_DIR}/streams.tap"
    RESULT_VARIABLE RESULT OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR TIMEOUT 10)
if(NOT RESULT EQUAL 0 OR NOT OUT STREQUAL "out" OR NOT ERR STREQUAL "err")
    message(FATAL_ERROR "stream separation/flush failed: ${RESULT}, stdout=${OUT}, stderr=${ERR}")
endif()
