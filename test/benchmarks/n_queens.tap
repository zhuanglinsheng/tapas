function count_queens(positions, row, size)
{
    if (row == size) {
        return 1
    }

    let count = 0
    for (let column in 0 to size) {
        let valid = true
        for (let previous in 0 to row) {
            let placed = positions[previous]
            let distance = row - previous
            if (placed == column) {
                valid = false
            }
            if (placed == column - distance) {
                valid = false
            }
            if (placed == column + distance) {
                valid = false
            }
        }
        if (valid) {
            positions[row] = column
            count = count + this(positions, row + 1, size)
        }
    }
    return count + 0
}

let size = 10
let positions = []
for (let row in 0 to size) {
    positions.append(-1)
}

let started = clock_ns()
let result = count_queens(positions, 0, size)
let elapsed = clock_ns() - started

print(result)
print(elapsed)
