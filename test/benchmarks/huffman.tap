function frequency_less(a, b)
{
    return a[0] < b[0]
}

function total_length(node, depth)
{
    if (types::matches(node[1], types::String)) {
        return node[0] * depth
    }

    let children = node[1]

    return this(children[0], depth + 1) + this(children[1], depth + 1)
}

function huffman_total(text)
{
    // The workload has a fixed small alphabet; count each symbol natively.
    let nodes = []

    for (let ch in 'abcdefgh') {
        let frequency = count(text, ch)

        if (frequency > 0) {
            nodes.append(frequency : ch)
        }
    }

    heap::heapify(nodes, frequency_less)

    while (nodes.len() > 1) {
        let left = heap::pop(nodes, frequency_less)
        let right = heap::pop(nodes, frequency_less)
        heap::push(nodes, (left[0] + right[0]) : (left : right), frequency_less)
    }

    return total_length(nodes[0], 0) + 0
}

let chars = []
let seed = 42

for (let index in 0 to 40000) {
    seed = (seed * 1103515245 + 12345) % 2147483648
    chars.append('abcdefgh'[seed % 8])
}

let text = strings::join(chars, '')

let started = clock_ns()
let result = huffman_total(text)
let elapsed = clock_ns() - started

print(result)
print(elapsed)
