function fannkuch(n)
{
    let perm1 = []
    let count = []
    for (let i in 0 to n) {
        perm1.append(i)
        count.append(0)
    }
    let checksum = 0
    let maxflips = 0
    let r = n
    while (true) {
        while (r != 1) {
            count[r - 1] = r
            r = r - 1
        }

        let perm = []
        for (let i in 0 to n) {
            perm.append(perm1[i])
        }
        let flips = 0
        let k = perm[0]
        while (k != 0) {
            let i = 0
            let j = k
            while (i < j) {
                let temporary = perm[i]
                perm[i] = perm[j]
                perm[j] = temporary
                i = i + 1
                j = j - 1
            }
            flips = flips + 1
            k = perm[0]
        }
        checksum = checksum + flips
        if (flips > maxflips) {
            maxflips = flips
        }

        while (true) {
            if (r == n) {
                return checksum + maxflips + 0
            }
            let first = perm1[0]
            for (let i in 0 to r) {
                perm1[i] = perm1[i + 1]
            }
            perm1[r] = first
            count[r] = count[r] - 1
            if (count[r] > 0) {
                break
            }
            r = r + 1
        }
    }
}

let n = 8

let started = clock_ns()
let result = fannkuch(n)
let elapsed = clock_ns() - started

print(result)
print(elapsed)
