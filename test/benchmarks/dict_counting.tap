let keys = []
for (let index in 0 to 500000) {
    keys.append(index % 4096)
}

function bench(n, keys)
{
    let started = clock_ns()
    let counts = {}

    for (let index in 0 to n) {
        let key = keys[index]
        if (key in counts) {
            counts[key] = counts[key]
        } else {
            counts[key] = key
        }
    }

    let elapsed = clock_ns() - started
    // 校验和必须依赖字典中存放的值：只用 len(counts) 无法发现被测的
    // 读+写回路径返回了错误的值。求和在校时点之后，不影响计时。
    var total = 0
    for (let key in 0 to 4096) {
        total = total + counts[key]
    }
    print(total)
    print(elapsed)
}

bench(500000, keys)
