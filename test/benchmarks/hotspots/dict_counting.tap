let input_keys = []

for (let index in 0 to 500000) {
    input_keys.append(index % 4096)
}

function bench(n, input_keys)
{
    let started = clock_ns()
    let counts = {}

    for (let index in 0 to n) {
        let key = input_keys[index]
        counts[key] = idx_or(counts, key, 0) + 1
    }

    let elapsed = clock_ns() - started

    // 校验和必须依赖字典中存放的值：只用 len(counts) 无法发现被测的
    // 读+写回路径返回了错误的值。求和在校时点之后，不影响计时。
    var total = 0

    for (let key in keys(counts)) {
        total = total + counts[key] * (key + 1)
    }

    print(total)
    print(elapsed)
}

bench(500000, input_keys)
