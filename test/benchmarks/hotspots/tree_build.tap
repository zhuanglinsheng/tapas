// Build and release fresh immutable-use trees; inspect the final full tree.
function tree_size(node)
{
    if (node.len() == 0) { return 1 }
    return 1 + this(node[0]) + this(node[1])
}

function make_tree(depth)
{
    if (depth == 0) {
        return []
    }
    let left = this(depth - 1)
    let right = this(depth - 1)
    return [left, right]
}


function bench(n)
{
    let started = clock_ns()
    let result = 0
    let tree = []
    for (let r in 0 to n) {
        tree = make_tree(10)
        result = result + tree.len()
    }
    result = result + tree_size(tree)
    let elapsed = clock_ns() - started
    print(result)
    print(elapsed)
}

bench(300)
