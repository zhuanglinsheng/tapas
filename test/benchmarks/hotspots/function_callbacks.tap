function add(left, right)
{
    return left + right
}

function apply(callback, left, right)
{
    return callback(left, right)
}

function bench(n, add, apply)
{
    let started = clock_ns()
    var total = 0

    for (let index in 0 to n) {
        total = apply(add, total, index % 7)
    }

    let elapsed = clock_ns() - started
    print(total)
    print(elapsed)
}

bench(200000, add, apply)
