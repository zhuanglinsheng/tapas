// One-row LCS update from the valid row for prefix 'ABCDAB'.
let right = 'DCBAABCDDCBAABCD'
function bench(n, right)
{
    let started = clock_ns()
    let previous = [0, 1, 1, 2, 2, 2, 3, 3, 4, 4, 4, 5, 5, 5, 6, 6, 6]
    let current = replicate([0], 17)
    let result = 0
    for (let r in 0 to n) {
        let ch = 'ABCD'[r % 4]
        for (let j in 1 to 17) {
            if (ch == right[j - 1]) { current[j] = previous[j - 1] + 1 }
            elif (previous[j] >= current[j - 1]) { current[j] = previous[j] }
            else { current[j] = current[j - 1] }
        }
        result = result + current[16]
    }
    for (let j in 0 to 17) { result = result + current[j] * j }
    let elapsed = clock_ns() - started
    print(result)
    print(elapsed)
}

bench(40000, right)
