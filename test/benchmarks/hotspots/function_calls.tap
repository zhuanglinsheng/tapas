function add(left, right)
{
    return left + right
}

function bench(n, add)
{
    let started = clock_ns()
    var total = 0

    for (let index in 0 to n) {
        total = add(total, index % 7)
    }

    let elapsed = clock_ns() - started
    print(total)
    print(elapsed)
}

bench(200000, add)
