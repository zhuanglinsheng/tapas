      "path": "/private/tmp/tapas-heap-order-callback.tap",
      "sha256": "183732a8f1899082e3e3705d6e1b3bcd8dcf7ce54cea963591a5ea409d7aeea6",
      "source": "function record_less(a, b) { return a[0] < b[0] or (a[0] == b[0] and a[1] < b[1]) }\nfunction bench(repetitions, values)\n{\n    let started = clock_ns()\n    var checksum = 0\n    for (let repetition in 0 to repetitions) {\n        let queue = copy(values)\n        heap::heapify(queue, record_less)\n        for (let position in 0 to len(values)) {\n            checksum = checksum + heap::pop(queue, record_less)[0] * (position + 1)\n        }\n    }\n    let elapsed = clock_ns() - started\n    print(checksum)\n    print(elapsed)\n}\nlet values = []\nfor (let i in 0 to 256) { values.append([(i * 73 + 19) % 31 - 15, i]) }\nbench(64, values)\n"
    },
