        "baseline": "local function primes_up_to(limit)\n    local is_prime = {}\n    for value = 0, limit do\n        is_prime[value] = value >= 2\n    end\n\n    local candidate = 2\n    while candidate * candidate <= limit do\n        if is_prime[candidate] then\n            local multiple = candidate * candidate\n            while multiple <= limit do\n                is_prime[multiple] = false\n                multiple = multiple + candidate\n            end\n        end\n        candidate = candidate + 1\n    end\n\n    local count = 0\n    for value = 2, limit do\n        if is_prime[value] then\n            count = count + 1\n        end\n    end\n    return count\nend\n\nlocal started = os.clock()\nlocal result = primes_up_to(200000)\n\nlocal elapsed = math.floor((os.clock() - started) * 1e9 + 0.5)\nprint(result)\nprint(elapsed)\n",
