        "baseline": "function primes_up_to(limit)\n{\n    let is_prime = dense::flat(array(1, limit + 1, true))\n    is_prime[0] = false\n    is_prime[1] = false\n    fill(is_prime, false, iter(4, 2, limit + 1))\n    for (let candidate in iter(3, 2, math::isqrt(limit) + 1)) {\n        if (is_prime[candidate]) {\n            fill(is_prime, false, iter(candidate * candidate, candidate, limit + 1))\n        }\n    }\n    return count(is_prime, true)\n}\nlet started = clock_ns()\nvar result = 0\nfor (let repetition in 0 to 1) { result = result + primes_up_to(20000) }\nprint(result)\nprint(clock_ns() - started)\n",
