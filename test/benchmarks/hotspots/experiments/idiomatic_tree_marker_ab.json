      "sha256": "e340d8f602b0c7adeaf69512cf064c9b189e1300c180ec3e39dc3d8a85756f9c",
      "source": "// false marks a leaf; every internal node is a fresh List.\n// Build and release fresh immutable-use trees; inspect the final full tree.\nfunction tree_size(node)\n{\n    if (node == false) { return 1 }\n    return 1 + this(node[0]) + this(node[1])\n}\n\nfunction make_tree(depth)\n{\n    if (depth == 0) {\n        return false\n    }\n    return [this(depth - 1), this(depth - 1)]\n}\n\n\nfunction bench(n)\n{\n    let started = clock_ns()\n    let result = 0\n    let tree = false\n    for (let r in 0 to n) {\n        tree = make_tree(10)\n        result = result + tree.len()\n    }\n    result = result + tree_size(tree)\n    let elapsed = clock_ns() - started\n    print(result)\n    print(elapsed)\n}\n\nbench(300)\n"
    },
    "candidate": {
      "path": "/private/tmp/tapas-tree-int-marker.tap",
      "sha256": "879e6d50d3ba57431c56e22e94bd4c8c0e0d7a892402998a55c38f38e3a16c09",
      "source": "// 0 marks a leaf; every internal node is a fresh List.\n// Build and release fresh immutable-use trees; inspect the final full tree.\nfunction tree_size(node)\n{\n    if (node == 0) { return 1 }\n    return 1 + this(node[0]) + this(node[1])\n}\n\nfunction make_tree(depth)\n{\n    if (depth == 0) {\n        return 0\n    }\n    return [this(depth - 1), this(depth - 1)]\n}\n\n\nfunction bench(n)\n{\n    let started = clock_ns()\n    let result = 0\n    let tree = 0\n    for (let r in 0 to n) {\n        tree = make_tree(10)\n        result = result + tree.len()\n    }\n    result = result + tree_size(tree)\n    let elapsed = clock_ns() - started\n    print(result)\n    print(elapsed)\n}\n\nbench(300)\n"
    }
  },
