      "source": "let values = []\nfor (let i in 0 to 512) {\n let value = (i * 73 + 19) % 1009 - 500\n if (i % 2 == 0) { values.append(value) } else { values.append(value * 0.5) }\n}\nlet started = clock_ns()\nvar checksum = 0\nfor (let repetition in 0 to 32) {\n let queue = copy(values)\n heap::heapify(queue)\n for (let i in 0 to len(values)) { checksum = checksum + int(heap::pop(queue) * 2) * (i + 1) }\n}\nprint(checksum)\nprint(clock_ns() - started)\n",
