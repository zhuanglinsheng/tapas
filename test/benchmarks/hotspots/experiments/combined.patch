+/* Pure built-in String equality, including the private indexed-byte form.
+ * Unknown objects must retain their operator hooks and normal fallback. */
+static int vm_string_equal(const tobj *left, const tobj *right, int *equal)
+{
+	int left_byte = vm_is_indexed_byte(left);
+	int right_byte = vm_is_indexed_byte(right);
+	if ((!left_byte && (left->type != tcompo || !left->val.v_tcompo ||
+			    left->val.v_tcompo->vtable != &tstr_vtable)) ||
+	    (!right_byte && (right->type != tcompo || !right->val.v_tcompo ||
+			     right->val.v_tcompo->vtable != &tstr_vtable)))
+		return 0;
+	if (left_byte && right_byte) {
+		*equal = left->val.v_tint == right->val.v_tint;
+	} else if (left_byte || right_byte) {
+		const tobj *byte = left_byte ? left : right;
+		tstr *string = (tstr *)(left_byte ? right : left)->val.v_tcompo;
+		*equal = tstring_len(string->data) == 1 &&
+			(unsigned char)tstring_cstr(string->data)[0] ==
+				byte->val.v_tint;
+	} else {
+		*equal = left->val.v_tcompo == right->val.v_tcompo ||
+			tstring_eq(((tstr *)left->val.v_tcompo)->data,
+				   ((tstr *)right->val.v_tcompo)->data);
+	}
+	return 1;
+}
