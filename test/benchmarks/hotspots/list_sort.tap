function bench(repetitions, values)
{
    let started = clock_ns()
    var checksum = 0
    for (let repetition in 0 to repetitions) {
        let ordered = copy(values)
        sort(ordered)
        for (let i in 0 to len(ordered)) {
            checksum = checksum + ordered[i] * (i + 1)
        }
    }
    print(checksum)
    print(clock_ns() - started)
}

let values = []
let seed = 42
for (let i in 0 to 4096) {
    seed = (seed * 1103515245 + 12345) % 2147483648
    values.append(seed % 2000001 - 1000000)
}
bench(16, values)
