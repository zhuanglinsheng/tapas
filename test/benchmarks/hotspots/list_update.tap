let values = replicate([0], 1024)

function bench(rounds, values)
{
    let started = clock_ns()

    for (let round in 0 to rounds) {
        for (let slot in 0 to 1024) {
            values[slot] = slot
        }
    }

    let elapsed = clock_ns() - started
    print(values[123] + values[1023] + len(values))
    print(elapsed)
}

bench(488, values)
