let source = list(0 to 1024)

function bench(rounds, source)
{
    var result = 0
    let started = clock_ns()

    for (let repetition in 0 to rounds) {
        let copied = source.copy()
        result = copied[1023]
    }

    let elapsed = clock_ns() - started
    print(result)
    print(elapsed)
}

bench(20000, source)
