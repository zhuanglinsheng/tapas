let values = replicate([0, 1, 2, 3, 4, 5, 6, 7], 62500)

function bench(n, values)
{
    var sink = 0
    let started = clock_ns()

    for (let index in 0 to n) {
        sink = values[index]
    }

    let elapsed = clock_ns() - started
    print(sink + len(values))
    print(elapsed)
}

bench(500000, values)
