function merge_sort(values)
{
    if (values.len() <= 1) {
        return values
    }

    let middle = values.len() / 2
    let left = this(values[:middle])
    let right = this(values[middle:])
    let left_size = left.len()
    let right_size = right.len()
    var merged = []
    let i = 0
    let j = 0

    while (i < left_size and j < right_size) {
        if (left[i] <= right[j]) {
            merged.append(left[i])
            i = i + 1
        } else {
            merged.append(right[j])
            j = j + 1
        }
    }

    while (i < left_size) {
        merged.append(left[i])
        i = i + 1
    }

    while (j < right_size) {
        merged.append(right[j])
        j = j + 1
    }

    return merged
}

let values = []

for (let index in 0 to 4096) {
    values.append((index * 73 + 19) % 1009)
}

let started = clock_ns()
let sorted = merge_sort(values)
let checksum = 0

for (let index in 0 to sorted.len()) {
    checksum = checksum + sorted[index] * (index + 1)
}

let elapsed = clock_ns() - started

print(checksum)
print(elapsed)
