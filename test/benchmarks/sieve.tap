function primes_up_to(limit)
{
    let is_prime = dense::flat(array(1, limit + 1, true))
    is_prime[0] = false
    is_prime[1] = false
    fill(is_prime, false, iter(4, 2, limit + 1))

    for (let candidate in iter(3, 2, math::isqrt(limit) + 1)) {
        if (is_prime[candidate]) {
            fill(is_prime, false, iter(candidate * candidate, candidate, limit + 1))
        }
    }

    return count(is_prime, true)
}

let started = clock_ns()
let result = primes_up_to(20000)

let elapsed = clock_ns() - started
print(result)
print(elapsed)
