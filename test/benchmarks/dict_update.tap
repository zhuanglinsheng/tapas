let values = {}
for (let index in 0 to 4096) {
    values[index] = 0
}

let started = clock_ns()
for (let index in 0 to 500000) {
    let key = index % 4096
    values[key] = values[key] + 1
}
let elapsed = clock_ns() - started

let result = 0
for (let index in 0 to 4096) {
    result = result + values[index]
}
print(result)
print(elapsed)
