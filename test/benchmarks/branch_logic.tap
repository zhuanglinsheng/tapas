function bench(n)
{
    let started = clock_ns()
    var state = 17

    for (let index in 0 to n) {
        if (state > 55) {
            state = state - 23
        } elif (state > 40 and state <= 55) {
            state = state + 21
        } elif (state < 20 or state == 20) {
            state = state + 31
        } else {
            state = state - 19
        }
    }

    let elapsed = clock_ns() - started
    print(state)
    print(elapsed)
}

bench(1000000)
