function lcs_length(left, right)
{
    let row_size = right.len() + 1
    let previous = replicate([0], row_size)
    let current = replicate([0], row_size)

    for (let i in 1 to (left.len() + 1)) {
        let character = left[i - 1]
        current[0] = 0
        let diagonal = 0
        let preceding = 0
        for (let j in 1 to row_size) {
            let above = previous[j]
            if (character == right[j - 1]) {
                preceding = diagonal + 1
            } elif (above > preceding) {
                preceding = above
            }
            current[j] = preceding
            diagonal = above
        }
        let temporary = previous
        previous = current
        current = temporary
    }
    return previous[row_size - 1] + 0
}

let left = 'DYNAMICPROGRAMMINGALGORITHMSANDDATASTRUCTURESARECENTRALTOVIRTUALMACHINEBENCHMARKS'
let right = 'ALGORITHMSFORDYNAMICLANGUAGESUSEPROGRAMSTRUCTUREANDRUNTIMEDATATOMEASUREPERFORMANCE'

let started = clock_ns()
let result = 0
for (let repetition in 0 to 40) {
    result = result + lcs_length(left, right)
}
let elapsed = clock_ns() - started

print(result)
print(elapsed)
