let pattern = [0, 1, 2, 3]

function bench(rounds, pattern)
{
    var result = 0
    let started = clock_ns()

    for (let repetition in 0 to rounds) {
        let values = replicate(pattern, 256)
        result = values[1023]
    }

    let elapsed = clock_ns() - started
    print(result)
    print(elapsed)
}

bench(20000, pattern)
