function bench(n)
{
    var result = 0
    let started = clock_ns()

    for (let index in 0 to n) {
        let values = {0: index % 97, 1: index % 89}
        result = result + values[0] - values[1]
    }

    let elapsed = clock_ns() - started
    print(result)
    print(elapsed)
}

bench(300000)
