function kmp_search(text, pattern)
{
    let pattern_size = pattern.len()
    let pi = replicate([0], pattern_size)
    let j = 0

    for (let i in 1 to pattern_size) {
        while (j > 0 and pattern[i] != pattern[j]) {
            j = pi[j - 1]
        }

        if (pattern[i] == pattern[j]) {
            j = j + 1
        }

        pi[i] = j
    }

    let total = 0
    j = 0

    for (let i in 0 to text.len()) {
        while (j > 0 and text[i] != pattern[j]) {
            j = pi[j - 1]
        }

        if (text[i] == pattern[j]) {
            j = j + 1
        }

        if (j == pattern_size) {
            total = total + i - pattern_size + 1
            j = pi[j - 1]
        }
    }

    return total + 0
}

let text_parts = replicate(['ABCABABCAB'], 500)
let text = strings::join(text_parts, '')
let pattern = 'ABCAB'
let rounds = 60

let started = clock_ns()
let result = 0

for (let round in 0 to rounds) {
    result = result + kmp_search(text, pattern)
}

let elapsed = clock_ns() - started

print(result)
print(elapsed)
