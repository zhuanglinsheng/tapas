function optimize(f, grad, start, tolerance, max_iterations)
{
    var c1 = 0.0001
    var rho = 0.5
    let line_search = (x, direction, fx) {
        var step = 1.0
        let gnorm2 = direction[0] * direction[0] + direction[1] * direction[1]
        while (true) {
            let next = [x[0] + step * direction[0], x[1] + step * direction[1]]
            if (f(next) <= fx - c1 * step * gnorm2) {
                return copy(next)
            }
            step = step * rho
        }
        return x
    }
    var x = [start[0], start[1]]
    var iterations = 0
    while (iterations < max_iterations) {
        let g = grad(x)
        let gnorm2 = g[0] * g[0] + g[1] * g[1]
        if (gnorm2 < tolerance) {
            break
        }
        x = line_search(x, [0.0 - g[0], 0.0 - g[1]], f(x))
        iterations = iterations + 1
    }
    return iterations + 0
}

let rosenbrock = (x) {
    let a = 1.0 - x[0]
    let b = x[1] - x[0] * x[0]
    return a * a + 100.0 * b * b
}

let rosenbrock_grad = (x) {
    let a = 1.0 - x[0]
    let b = x[1] - x[0] * x[0]
    return [0.0 - 2.0 * a - 400.0 * x[0] * b, 200.0 * b]
}

let started = clock_ns()
let result = optimize(rosenbrock, rosenbrock_grad, [-1.2, 1.0], 0.00000001, 100000)
let elapsed = clock_ns() - started

print(result)
print(elapsed)
