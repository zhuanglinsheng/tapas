function solve_board(grid)
{
    let index = 0
    while (index < 81) {
        if (grid[index] == 0) {
            let row = (index / 9) * 9
            let column = index % 9
            let box = (index / 27) * 27 + (column / 3) * 3
            let digit = 1
            while (digit < 10) {
                let valid = true
                let k = 0
                while (k < 9) {
                    if (grid[row + k] == digit or grid[column + k * 9] == digit) {
                        valid = false
                        break
                    }
                    if (grid[box + (k / 3) * 9 + k % 3] == digit) {
                        valid = false
                        break
                    }
                    k = k + 1
                }
                if (valid) {
                    grid[index] = digit
                    if (this(grid)) {
                        return true
                    }
                }
                digit = digit + 1
            }
            grid[index] = 0
            return false
        }
        index = index + 1
    }
    return true
}

let puzzle = [
    1, 0, 0, 0, 0, 7, 0, 9, 0,
    0, 3, 0, 0, 2, 0, 0, 0, 8,
    0, 0, 9, 6, 0, 0, 5, 0, 0,
    0, 0, 5, 3, 0, 0, 9, 0, 0,
    0, 1, 0, 0, 8, 0, 0, 0, 2,
    6, 0, 0, 0, 0, 4, 0, 0, 0,
    3, 0, 0, 0, 0, 0, 0, 1, 0,
    0, 4, 0, 0, 0, 0, 0, 0, 7,
    0, 0, 7, 0, 0, 0, 3, 0, 0,
]
let repetitions = 10

let started = clock_ns()
var checksum = -1
for (let round in 0 to repetitions) {
    let board = copy(puzzle)
    let solved = solve_board(board)
    if (not solved) {
        checksum = -1
        break
    }
    checksum = 0
    for (let index in 0 to 81) {
        checksum = checksum + board[index] * (index + 1)
    }
}
let elapsed = clock_ns() - started

print(checksum)
print(elapsed)
