function bench(n)
{
    let started = clock_ns()
    var total = 0

    for (let index in 0 to n) {
        if (index % 2 == 0) {
            continue
        }
        total = total + index % 7
        total = total + index % 5
        total = total - index % 3
        total = total + index % 11
    }

    let elapsed = clock_ns() - started
    print(total)
    print(elapsed)
}

bench(2000000)
