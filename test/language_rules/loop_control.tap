var total = 0

for(let outer in 0 to 5){
    if(outer == 1){
        continue
    }

    for(let inner in 0 to 5){
        if(inner == 1){
            continue
        }
        if(inner == 3){
            break
        }
        total = total + outer * 10 + inner
    }

    if(outer == 3){
        break
    }
}

print(total)

var index = 0
var whileTotal = 0
while(index < 6){
    index = index + 1
    if(index == 2){
        continue
    }
    if(index == 5){
        break
    }
    whileTotal = whileTotal + index
}

print(whileTotal)
