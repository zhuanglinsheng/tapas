let Number = types::union(types::Int, types::Float)
let Numeric = Number
var amount: Numeric = 1
amount = 2.5

let IntPair = types::pair(types::Int, types::Int)
var coordinates: IntPair = 1 : 2

let Point = types::make_type(
    'x' : types::Int,
    'y' : types::Float,
)
let point: Point = {'x' : 1, 'y' : 2.5}
let positional: Point = {3, 4.5}
let mixed: Point = {5, y=6.5}
let named: Point = {y=8.5, x=7}
let PointAlias = Point
let aliased: PointAlias = {9, 10.5}

print(amount)
print(types::matches(coordinates, IntPair))
print(types::matches(point, Point))
print(positional['x'])
print(mixed['y'])
print(named['x'])
print(aliased['y'])
