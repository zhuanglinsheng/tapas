let left = array(1, 2, [2, 4])
let right = array(1, 2, [1, 2])
sprint(left + 1)
sprint(10 - left)
sprint(left * right)
sprint(left / right)
sprint(left % 3)
sprint(10 % left)
sprint(left % right)
sprint(left ^ 2)
sprint(left > 2)
let flags = array(1, 2, [true, false])
sprint(flags & true)
sprint(false | flags)
