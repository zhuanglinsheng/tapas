let integers: List[Int] = [1, 2, 3]
let nested: List[List[Float]] = [[1.5, 2.5]]
let entry: Pair[String, Int,] = 'count' : 3
let scores: types::Dictionary[
    String,
    Float,
] = {'Ada' : 9.5}
let identifier: Union[Int, String] = 'tapas'

print(types::matches(integers, types::list(types::Int)))
print(types::matches(nested, types::list(types::list(types::Float))))
print(types::matches(entry, types::pair(types::String, types::Int)))
print(types::matches(
    scores,
    types::dictionary(types::String, types::Float),
))
print(types::matches(
    identifier,
    types::union(types::Int, types::String),
))
