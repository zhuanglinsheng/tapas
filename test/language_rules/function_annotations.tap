let sum = (values: List[Int], offset: Int) -> Int {
    return values[0] + offset
}

function factorial(value: Int) -> Int {
    if(value <= 1){
        return 1
    }
    return value * this(value - 1)
}

function count(...) -> Int {
    return __nparam__()
}

let identity = (Int: Int) -> Int {
    return Int
}

print(sum([4], 3))
print(factorial(5))
print(count('a', true, 3))
print(identity(9))
