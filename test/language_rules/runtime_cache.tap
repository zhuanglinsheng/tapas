let sum_values = (values){
    var total = 0
    for(let value in values){
        total = total + value
    }
    return total
}

let repeat_until_three = (values){
    var total = 0
    var pass = 0
    while(pass < 2){
        for(let value in values){
            if(value == 3){
                break
            }
            total = total + value
        }
        pass = pass + 1
    }
    return total
}

print(sum_values([1, 2, 3]))
print(sum_values(1 to 4))
print(sum_values([4, 5]))
print(repeat_until_three([1, 2, 3, 4]))

let first = (values){
    return values[0]
}

let replace_last = (values, value){
    values[-1] = value
    return values[-1]
}

let increment = (value){ return value + 1 }
let double = (value){ return value * 2 }
let apply = (operation, value){ return operation(value) }

print(first([7, 8]))
print(first("ab"))
print(first([9, 10]))
print(replace_last([1, 2], 5))
print(apply(increment, 4))
print(apply(double, 4))

let read_cell = (values, row, column){
    return values[row, column]
}

let write_cell = (values, row, column, value){
    values[row, column] = value
    return values[row, column]
}

let numbers = array(2, 2, [1, 2, 3, 4])
print(read_cell(numbers, -1, -1))
print(write_cell(numbers, 0, 1, 9))

let flags = array(2, 2, [true, false, false, true])
print(read_cell(flags, 1, 0))
print(write_cell(flags, -1, 0, true))
