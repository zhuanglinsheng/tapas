let range_values = list(2 to 7)
print(len(range_values))
print(range_values[0])
print(range_values[-1])

let original = [8, 9]
let copied = list(original)
copied[0] = 3
print(original[0])
print(copied[0])
print(len(list()))

let repeated = replicate([1, 2], 3)
print(len(repeated))
print(repeated[0])
print(repeated[5])
print(len(replicate([1], 0)))

let nested = [[]]
let repeated_nested = replicate(nested, 2)
repeated_nested[0].append(7)
print(len(repeated_nested[1]))

let literal_iterator = [2 to 4]
print(len(literal_iterator))
print(len(literal_iterator[0]))
