assert(rule { strings::split('a::b::', '::') == ['a', 'b', ''] })
assert(rule { strings::split('', ',') == [''] })
assert(rule { strings::lines('a\r\nb\rc\n') == ['a', 'b', 'c'] })
assert(rule { strings::lines('') == [] and strings::lines('\n') == [''] })
assert(rule { strings::trim(' \t你好\r\n') == '你好' })
assert(rule { strings::find('ababa', 'aba') == 0 })
assert(rule { strings::find('ababa', 'aba', 1) == 2 })
assert(rule { strings::find('ababa', 'a', -1) == 4 })
assert(rule { strings::find('abc', '', 4) == -1 })
assert(rule { strings::find('abc', 'x') == -1 })
assert(rule { strings::replace('aaaaa', 'aa', 'x') == 'xxa' })
assert(rule { strings::replace('你好你好', '你好', '好') == '好好' })
assert(rule { strings::starts_with('你好', '你') and strings::ends_with('你好', '好') })
assert(rule { strings::starts_with('', '') and strings::ends_with('abc', '') })

let binary = json::parse('"a\\u0000b"')

assert(rule { strings::find(binary, 'b') == 2 and str(binary) == binary })
assert(rule { strings::split(binary, json::parse('"\\u0000"')) == ['a', 'b'] })
assert(rule { bytes::to_string(bytes::from_string(binary)) == binary })

let buffer = bytes::from_string('你好')

assert(rule { len(buffer) == 6 and strings::is_utf8(bytes::to_string(buffer)) })

let invalid_utf8 = bytes::buffer(1, 255)

assert(rule { not strings::is_utf8(bytes::to_string(invalid_utf8)) })
assert(rule { strings::is_utf8('') and strings::is_utf8(binary) })

let raw_input = bytes::from_string('abc')
let detached = bytes::to_string(raw_input)
raw_input[0] = 120
assert(rule { detached == 'abc' and bytes::to_string(raw_input) == 'xbc' })
assert(rule { int('  +12') == 12 and int(-3.75) == -3 })
assert(rule { float('  1.5') == 1.5 and float(true) == 1.0 })
assert(rule { try_int('12')::ok and try_int('12')::value == 12 })
assert(rule { try_float('1.5')::ok and try_float('1.5')::value == 1.5 })
assert(rule { not try_int('')::ok and not try_float('')::ok })
assert(rule { not try_float(' ')::ok and not try_int('12 ')::ok })
assert(rule { not try_float('1e999')::ok and not try_float('nan')::ok })
assert(rule { not try_int(math::make_nan())::ok })
assert(rule { not try_int(9223372036854775808.0)::ok })
assert(rule { try_int(-9223372036854775808.0)::ok })
assert(rule { not try_int(json::parse('"12\\u0000x"'))::ok })
assert(rule { not try_float(json::parse('"1.5\\u0000x"'))::ok })
assert(rule { try_int([])::code == 'invalid_type' })
assert(rule { try_int('9223372036854775808')::code == 'out_of_range' })
assert(rule { bool(json::parse('"false\\u0000x"')) })
assert(rule { path::join('fixtures', 'orders.json') == 'fixtures/orders.json' })
assert(rule { path::join('a', '/b', 'c') == '/b/c' })
assert(rule { path::join('a', '..', 'b') == 'a/../b' })
assert(rule { path::normalize('a/../../b') == '../b' })
assert(rule { path::normalize('/a/../../b//') == '/b' })
assert(rule { path::normalize('') == '.' and path::normalize('a/..') == '.' })
assert(rule { path::basename('/a/file.tap/') == 'file.tap' })
assert(rule { path::dirname('/a/file.tap/') == '/a' })
assert(rule { path::dirname('file') == '.' and path::dirname('/') == '/' })
assert(rule { path::extension('/a/.env') == '' and path::extension('/a/a.tar.gz') == '.gz' })
assert(rule { path::extension('..env') == '' and path::extension('..') == '' and path::extension('file.') == '.' })
assert(rule { path::is_absolute('/a') and not path::is_absolute('a') })

let missing = io::try_read_text('/__tapas_missing_fixture_directory__/x')

assert(rule { not missing::ok and missing::code == 'not_found' and missing::value == '' })
assert(rule { not io::try_read_text(binary)::ok })
assert(rule { io::try_read_text(42)::code == 'invalid_type' })
assert(rule { io::try_write_text('', '')::code == 'invalid_path' })
print('ok')
