function check(condition) { assert(rule { condition }) }

check([] < [0])
check([] <= [])
check([] >= [])
check(not ([] > []))
check([1, 9] < [2, 0])
check([1, 9] > [1, 3])
check([1] < [1, 0])
check([1, 2] <= [1, 2])
check([1, 2] >= [1, 2])
check(not ([1, 2] < [1, 2]))
check([1, [2, 'a']] < [1, [2, 'b']])
check(['a'] < ['aa'])
check(['abc'] < ['abd'])
check([9007199254740992.0] < [9007199254740993])
check([9007199254740993] > [9007199254740992.0])
check([9223372036854775807] < [9223372036854775808.0])
check([-9223372036854775808.0] < [-9223372036854775807])
check([1] <= [1.0])
check([1] >= [1.0])
// Structural equality retains its existing type-sensitive element semantics.
check([1] != [1.0])
// Only the first differing position decides ordering.
check([0, {}] < [1, []])

let records = [[2, 'b'], [1], [2, 'a'], [], [1, 0], [2, 'a']]
let expected = [[], [1], [1, 0], [2, 'a'], [2, 'a'], [2, 'b']]
let batch = copy(records)
let incremental = []
heap::heapify(batch)
for (let record in records) { heap::push(incremental, record) }
let sorted_records = copy(records)
sort(sorted_records)
check(sorted_records == expected)
for (let record in expected) {
    check(heap::peek(batch) == record)
    check(heap::pop(batch) == record)
    check(heap::pop(incremental) == record)
}
check(len(batch) == 0)
check(len(incremental) == 0)
let float_values = [3.5, -2.5, 0.0, 3.5]
sort(float_values)
check(float_values == [-2.5, 0.0, 3.5, 3.5])
let precise_values = [9007199254740993, 9007199254740992.0, 9007199254740992]
sort(precise_values)
check(identical(precise_values[2], 9007199254740993))

let words = ['b', 'aa', 'a']
heap::heapify(words)
check(heap::pop(words) == 'a')
check(heap::pop(words) == 'aa')
check(heap::pop(words) == 'b')
let maximum = [[1, 9], [2, 0], [1, 3]]
let greater = (a, b) { return a > b }
heap::heapify(maximum, greater)
check(heap::pop(maximum, greater) == [2, 0])
check(heap::pop(maximum, greater) == [1, 9])
check(heap::pop(maximum, greater) == [1, 3])
// A new List operator must preserve the other operand's symbolic operators.
let parameter = rules::parameter('items', types::List)
let Ordered = rules::make('Ordered', [parameter], [
    rules::condition([1] < parameter),
    rules::condition([2] <= parameter),
    rules::condition([3] > parameter),
    rules::condition([2] >= parameter),
    rules::condition(parameter > [1]),
    rules::condition(parameter < [3])
])
assert(Ordered([2]))
print('ok')
