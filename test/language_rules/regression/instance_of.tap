let Positive = rule (value: Int) { value > 0 }
let Other = rule (value: Int) { value > 0 }

// InstanceOf remains a compile-time identity annotation.
function accept(action: InstanceOf[Positive])
{
	return arguments(action)[0]
}

let PositiveAlias = Positive
assert(rule { accept(PositiveAlias(5)) == 5 })

let action: InstanceOf[Positive] = Positive(3)
assert(rule { accept(action) == 3 })
var reassigned: InstanceOf[Positive] = Positive(1)
reassigned = Positive(2)
assert(rule { arguments(reassigned)[0] == 2 })

// Runtime identity checks are explicit Type operations.
let PositiveInstance = types::instance_of(Positive)
assert(rule {
	types::matches(Positive(1), PositiveInstance)
	types::matches(Other(1), PositiveInstance) == false
})

// Calls through an Unknown callback do not attach or enforce source annotations
// at runtime. A statically known direct call with Other is rejected instead.
function invoke(callback, action) { return callback(action) }
assert(rule { invoke(accept, Other(4)) == 4 })

let Composed = rule (instance: InstanceOf[Positive]) { instance }
assert(Composed(Positive(2)))

let Empty = rule () { true }
let EmptyInstance = types::instance_of(Empty)
assert(rule {
	types::matches(Empty(), EmptyInstance)
	types::matches(Positive(1), EmptyInstance) == false
})
