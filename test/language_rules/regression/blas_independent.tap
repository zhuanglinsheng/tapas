let left = array(1, 2, [2, 4])
let right = array(1, 2, [1, 2])
pprint(left + 1)
pprint(10 - left)
pprint(left * right)
pprint(left / right)
pprint(left % 3)
pprint(10 % left)
pprint(left % right)
pprint(left ^ 2)
pprint(left > 2)
let flags = array(1, 2, [true, false])
pprint(flags & true)
pprint(false | flags)
pprint(dense::identity(2))
print(dense::trace(array(2, 2, [1, 2, 3, 4])))
