let sum_values = (values)
{
    var total = 0
    for (let value in values) {
        total = total + value
    }
    return total
}

sum_values([1, 2, 3])
__binary__(sum_values)

let left_text = "abc"
let right_text = "axc"
left_text[0] == right_text[0]

let native_alias = len
len([1])
native_alias([1])

let invoke_captured = (callback, value)
{
    let inner = ()
    {
        return callback(value)
    }
    return inner()
}
invoke_captured(sum_values, [1, 2, 3])

function retained_target(values)
{
    return len(values)
}

function retained_call(values)
{
    var callback = retained_target
    callback = retained_target
    return callback(values)
}
retained_call([1, 2, 3])
clock_ns()
