let data = json::parse('{"name":"你好","active":true,"items":[null,1,2.5],"empty":{},"list":[]}')
assert(rule { data::name == '你好' and data::active })
assert(rule { data::items[1] == 1 and data::items[2] == 2.5 })
assert(rule { types::matches(data::items[0], json::Null) })
assert(rule { identical(data::items[0], json::null) })
assert(rule { json::null == copy(json::null) and json::null != 0 })
assert(rule { len(data::empty) == 0 and len(data::list) == 0 })
assert(rule { json::stringify(json::null) == 'null' })
assert(rule { json::stringify([1, true, json::null]) == '[1,true,null]' })
assert(rule { json::parse(json::stringify(data))::name == '你好' })
assert(rule { json::parse(json::stringify(data, true))::items == data::items })
assert(rule { json::parse('9223372036854775807') == 9223372036854775807 })
assert(rule { json::stringify(json::parse('-9223372036854775808')) == '-9223372036854775808' })
assert(rule { json::parse('9007199254740993') == 9007199254740993 })
assert(rule { types::matches(json::parse('1.0'), types::Float) })
let zero = json::parse('"a\\u0000b"')
assert(rule { len(zero) == 3 and json::stringify(zero) == '"a\\u0000b"' })
let zero_key = json::parse('{"a\\u0000b":1,"a":2}')
assert(rule { zero_key[zero] == 1 and zero_key['a'] == 2 })
var result = json::try_parse('null')
for (let invalid in ['', '[1,]', '{"a":1,"a":2}', '9223372036854775808', '-9223372036854775809', '18446744073709551616', '1e999', 'true false', 'NaN', '//x\n1', '"\\uD800"']) {
    result = json::try_parse(invalid)
    assert(rule { not result::ok and len(result::error) > 0 })
    assert(rule { identical(result::value, json::null) })
}
let good = json::try_parse('null')
assert(rule { good::ok and good::error == '' and good::position == -1 })
assert(rule { identical(good::value, json::null) })
let bad = json::try_parse('[1,]')
assert(rule { bad::position >= 0 })
let deep = strings::join([strings::join(replicate(['['], 257), ''), '0', strings::join(replicate([']'], 257), '')], '')
assert(rule { not json::try_parse(deep)::ok })
let shared = [1, 2]
assert(rule { json::stringify([shared, shared]) == '[[1,2],[1,2]]' })
print('ok')
