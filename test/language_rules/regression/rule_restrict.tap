let R = rule(x: Int, flag: Bool) { x >= 0; flag }
let S = rules::restrict(R, 'x': rules::range(2, 5), 'flag': true)
assert(S(2, true))
assert(S(5, true))
assert(rule { not S(1, true); not S(6, true); not S(3, false) })
let T = rules::restrict(S, 'x': 4)
assert(T(4, true))
assert(rule { not T(3, true) })
let P = rules::restrict(R, 'x': rules::points(types::Int, -1, 3, 9))
assert(P(3, true))
assert(rule { not P(-1, true); not P(2, true) })
let contradictory = rules::restrict(R, 'x': 1, 'x': 2)
assert(rule { not contradictory(1, true); not contradictory(2, true) })
let empty = rules::restrict(R, 'x': rules::points(types::Int))
assert(rule { not empty(0, true) })
assert(rules::restrict(R)(7, true))
assert(R(7, true))
assert(rule { not S(7, true) })
// The original closure is retained, including later updates.
var minimum = 2
let captured = rule(x: Int) { x >= minimum }
let bounded = rules::restrict(captured, 'x': rules::range(0, 9))
assert(bounded(3))
minimum = 4
assert(rule { not bounded(3) })
assert(bounded(4))
let Color = types::enum('red', 'blue')
let colors = rule(color: Color) { true }
let red = rules::restrict(colors, 'color': 'red')
assert(red('red'))
assert(rule { not red('blue') })
let ir = rules::inspect(S)
assert(rule { len(rules::parameters(ir)) == 2; len(rules::items(ir)) == 3 })
// Dynamic Rules use the same restriction path.
let parameter = rules::parameter('x', types::Int)
let dynamic = rules::make('dynamic', [parameter], [])
let restricted_dynamic = rules::restrict(dynamic, 'x': rules::points(types::Int, 2, 4))
assert(restricted_dynamic(2))
assert(rule { not restricted_dynamic(3) })
print('restrict: ok')
