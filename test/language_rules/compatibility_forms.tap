let Number = types::union(types::Int, types::Float)
let typed_compatibility_value: Number = 7
let function_compatibility_value = function(x){ return x + 1 }
let kappa_compatibility_value = #{ 40 + 2 }

print(typed_compatibility_value)
print(function_compatibility_value(4))
print(kappa_compatibility_value())
print(#{ __nparam__() }(1, 2, 3))
