/**
 * @file version.h
 * @brief 声明构建时生成的 Tapas 版本与项目信息。
 *
 * @details CMake 配置阶段会把项目版本写入本模板，其余宏提供版权年份、项目主页
 * 和问题反馈地址。
 *
 * @note 本文件是配置模板；公共代码应包含生成后的 `tapas/version.h`。
 */
#ifndef TAPAS_VERSION_H
#define TAPAS_VERSION_H

/** 当前 Tapas 版本字符串。 */
#define TAPAS_VERSION "@PROJECT_VERSION@"

/** 项目版权声明使用的年份范围。 */
#define TAPAS_COPYRIGHT_YEARS "2020-2026"

/** 项目主页地址。 */
#define TAPAS_HOMEPAGE "https://github.com/zhuanglinsheng/tapas"

/** 项目问题反馈地址。 */
#define TAPAS_BUG_REPORT_URL "https://github.com/zhuanglinsheng/tapas/issues"

#endif /* TAPAS_VERSION_H */
