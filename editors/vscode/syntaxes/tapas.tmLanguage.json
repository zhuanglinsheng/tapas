{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Tapas",
  "scopeName": "source.tapas",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#functions" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#types" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.tapas", "match": "//.*$" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.tapas",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.tapas", "match": "\\\\[nrt\\\\'\\\"]" }
          ]
        },
        {
          "name": "string.quoted.single.tapas",
          "begin": "'",
          "end": "'",
          "patterns": [
            { "name": "constant.character.escape.tapas", "match": "\\\\[nrt\\\\'\\\"]" }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.float.tapas", "match": "(?<![A-Za-z0-9_])(?:\\d+\\.\\d*|\\.\\d+|\\d+(?:\\.\\d*)?[eE][+-]?\\d+)(?![A-Za-z0-9_])" },
        { "name": "constant.numeric.integer.tapas", "match": "(?<![A-Za-z0-9_])(?:0|[1-9]\\d*)(?![A-Za-z0-9_])" }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b(function)(\\s+)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.tapas" },
            "3": { "name": "entity.name.function.tapas" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.tapas", "match": "\\b(?:if|elif|else|while|for|in|to|break|continue|return|implies)\\b" },
        { "name": "storage.type.tapas", "match": "\\b(?:let|var|function|rule|import|as)\\b" },
        { "name": "keyword.operator.logical.tapas", "match": "\\b(?:and|or|not|of)\\b" }
      ]
    },
    "constants": {
      "patterns": [
        { "name": "constant.language.tapas", "match": "\\b(?:nil|true|false|this|base)\\b" }
      ]
    },
    "types": {
      "patterns": [
        { "name": "support.type.tapas", "match": "\\b(?:AnyType|Nil|Bool|Int|Float|String|List|Pair|Dictionary|Iterator|Function|Library|RealArray|BoolArray|Time|Type|Indexable|IndexSettable|Appendable|Deletable|Contains|Iterable|Rule|RuleInstance|RuleIR|RuleTerm|RuleItem|Parameter|Capture|Condition|Requirement|Origin|CheckResult|Violation|RuleDiagnostic|Evaluator|Context|Result|EvaluatorDiagnostic|Source|Generator|Index|Distribution|Union|InstanceOf|PointsOf|RangeOf)\\b" },
        { "name": "support.namespace.tapas", "match": "\\b(?:dense|evaluators|finite|io|math|random|rules|solve|optimize|syntax|time|types)\\b" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.tapas", "match": "->|::|==|!=|>=|<=|\\.\\.\\.|[=<>+\\-*/%^@&|.:]" }
      ]
    }
  }
}
