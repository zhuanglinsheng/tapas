{
  "name": "tapas-language",
  "displayName": "Tapas Language Support",
  "description": "Tapas language support, formatting, diagnostics, navigation, and refactoring",
  "version": "0.1.0",
  "publisher": "tapas-language",
  "icon": "images/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhuanglinsheng/tapas.git"
  },
  "homepage": "https://github.com/zhuanglinsheng/tapas#readme",
  "bugs": {
    "url": "https://github.com/zhuanglinsheng/tapas/issues"
  },
  "keywords": [
    "tapas",
    "programming language",
    "language server",
    "lsp",
    "formatter"
  ],
  "pricing": "Free",
  "extensionKind": [
    "workspace"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:tapas",
    "onCommand:tapas.runFile",
    "onCommand:tapas.formatDocument"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "tapas",
        "aliases": ["Tapas", "tapas"],
        "extensions": [".tap"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tapas",
        "scopeName": "source.tapas",
        "path": "./syntaxes/tapas.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "tapas.runFile",
        "title": "Tapas: Run Current File",
        "icon": "$(play)"
      },
      {
        "command": "tapas.formatDocument",
        "title": "Tapas: Format Document"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "tapas.runFile",
          "when": "editorLangId == tapas",
          "group": "navigation@10"
        }
      ],
      "editor/context": [
        {
          "command": "tapas.runFile",
          "when": "editorLangId == tapas",
          "group": "navigation"
        },
        {
          "command": "tapas.formatDocument",
          "when": "editorLangId == tapas",
          "group": "modification"
        }
      ]
    },
    "configuration": {
      "title": "Tapas",
      "properties": {
        "tapas.languageServer.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path to tapas-language-server. Empty searches the default ~/.tapas installation and PATH."
        },
        "tapas.runtime.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Path to the tapas executable. Empty searches the default ~/.tapas installation and PATH."
        }
      }
    }
  },
  "scripts": {
    "test": "node test/protocol.test.js",
    "test:package": "node test/package.test.js",
    "vscode:prepublish": "node test/package.test.js"
  }
}
