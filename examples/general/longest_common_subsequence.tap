/// longest_common_subsequence.tap
///
/// 用动态规划求两个字符串的最长公共子序列。
/// 先在二维数组中记录各前缀的最优长度，再回溯得到一条最长公共子序列。
/// 子序列保留原字符顺序，但不要求字符在原字符串中连续。

function longest_common_subsequence(left: String, right: String) -> String
{
    let rows = left.len() + 1
    let columns = right.len() + 1
    // lengths[i, j] stores the best length for both prefixes ending at i, j.
    let lengths: RealArray = array(rows, columns, 0)

    for (let i in 1 to rows) {
        for (let j in 1 to columns) {
            if (left[i - 1] == right[j - 1]) {
                lengths[i, j] = lengths[i - 1, j - 1] + 1
            } elif (lengths[i - 1, j] >= lengths[i, j - 1]) {
                lengths[i, j] = lengths[i - 1, j]
            } else {
                lengths[i, j] = lengths[i, j - 1]
            }
        }
    }

    let i = left.len()
    let j = right.len()
    // Backtracking discovers characters from the end, so reverse once later.
    let reversed: List[String] = []
    while (i > 0 and j > 0) {
        if (left[i - 1] == right[j - 1]) {
            reversed.append(left[i - 1])
            i = i - 1
            j = j - 1
        } elif (lengths[i - 1, j] >= lengths[i, j - 1]) {
            i = i - 1
        } else {
            j = j - 1
        }
    }

    let result: String = ''
    for (let index in iter(reversed.len() - 1, -1, -1)) {
        result.append(reversed[index])
    }
    return str(result)
}

let left: String = 'ALGORITHM'
let right: String = 'LOGARITHM'
print('left: ', left)
print('right: ', right)
print('longest common subsequence: ', longest_common_subsequence(left, right))
