/// newton_method.tap
///
/// 用牛顿迭代法近似求根。
/// 分别计算 2 的平方根和方程 x^3 - x - 2 = 0 的一个实根。
/// 展示浮点运算、误差判断和迭代更新；示例为两项计算分别选择起点与停止条件。

function square_root(
        value    : Int | Float,
        tolerance: Float,
) -> Float {
    assert(rule {
        tolerance > 0.0
        value >= 0
    })

    if (value == 0) {
        return 0.0
    }

    let estimate: Float = float(value)
    while (math::abs(estimate * estimate - value) > tolerance) {
        estimate = (estimate + value / estimate) / 2.0
    }
    return float(estimate)
}

// Solve x^3 - x - 2 = 0.
function cubic_root(initial: Float, tolerance: Float) -> Float
{
    assert(rule { tolerance > 0.0 })

    let x: Float = initial
    let step: Float = 1.0
    while (math::abs(step) > tolerance) {
        let value: Float = x * x * x - x - 2.0
        let derivative: Float = 3.0 * x * x - 1.0
        // Newton update: x_next = x - f(x) / f_derivative(x).
        step = value / derivative
        x = x - step
    }
    return float(x)
}

print('sqrt(2) = ', square_root(2, 1e-12))
print('root of x^3 - x - 2 = ', cubic_root(1.5, 1e-12))
