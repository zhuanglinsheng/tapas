// Binary search in an ascending list.
// The input must be sorted. Time: O(log n); space: O(1).

function binary_search(xs: List[Int], target: Int) -> Int
{
    let low = 0
    let high = xs.len() - 1

    while (low <= high) {
        // This form avoids adding low and high before division.
        let middle = low + (high - low) / 2
        if (xs[middle] == target) {
            return middle + 0
        } elif (xs[middle] < target) {
            low = middle + 1
        } else {
            high = middle - 1
        }
    }
    return -1
}

let values: List[Int] = [1, 3, 4, 7, 9, 12, 18, 25]
pprint('values: ', values)
print('index of 12 = ', binary_search(values, 12))
print('index of 8 = ', binary_search(values, 8))
