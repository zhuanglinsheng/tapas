/// euclidean_algorithm.tap
///
/// 计算最大公约数、最小公倍数和扩展欧几里得结果。
/// 通过反复取余求最大公约数，并求出满足 a*x + b*y = gcd(a, b) 的系数。
/// 展示整数运算、循环更新，以及用列表返回多个结果。

function gcd(a: Int, b: Int) -> Int
{
    let left = math::abs(a)
    let right = math::abs(b)
    while (right != 0) {
        let remainder = left % right
        left = right
        right = remainder
    }
    return left + 0
}

function lcm(a: Int, b: Int) -> Int
{
    if (a == 0 or b == 0) {
        return 0
    }
    return math::abs((a / gcd(a, b)) * b)
}

// Return [g, x, y], where a*x + b*y = g = gcd(a, b).
function extended_gcd(a: Int, b: Int) -> List[Int]
{
    let old_r = a
    let r = b
    let old_s = 1
    let s = 0
    let old_t = 0
    let t = 1

    while (r != 0) {
        let quotient = old_r / r

        let next_r = old_r - quotient * r
        old_r = r
        r = next_r

        let next_s = old_s - quotient * s
        old_s = s
        s = next_s

        let next_t = old_t - quotient * t
        old_t = t
        t = next_t
    }
    let result: List[Int] = [old_r, old_s, old_t]
    return result.copy()
}

print('gcd(252, 105) = ', gcd(252, 105))
print('lcm(21, 6) = ', lcm(21, 6))
pprint('extended_gcd(252, 105) = ', extended_gcd(252, 105))
