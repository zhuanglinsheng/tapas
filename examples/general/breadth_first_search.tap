/// breadth_first_search.tap
///
/// 用广度优先搜索遍历图。
/// 图由邻接字典表示，从 A 出发，用队列依次访问可达顶点并输出遍历顺序。
/// 顶点入队时即标记为已访问，避免重复入队，展示字典、列表和成员判断。

function breadth_first_search(
        graph: Dictionary[String, List[String]],
        start: String,
) -> List[String] {
    let queue: List[String] = [start]
    let visited: List[String] = [start]
    let order: List[String] = []

    while (queue.len() > 0) {
        let vertex = queue[0]
        queue.pop_front()
        order.append(vertex)

        for (let neighbor in graph[vertex]) {
            if ((neighbor in visited) == false) {
                // Mark on enqueue so a vertex never enters the queue twice.
                visited.append(neighbor)
                queue.append(neighbor)
            }
        }
    }
    return order.copy()
}

let graph: Dictionary[String, List[String]] = {
    'A' : ['B', 'C'],
    'B' : ['A', 'D', 'E'],
    'C' : ['A', 'F'],
    'D' : ['B'],
    'E' : ['B', 'F'],
    'F' : ['C', 'E'],
}

pprint('BFS from A: ', breadth_first_search(graph, 'A'))
