/// data.tap
///
/// 商品目录。
///
/// 保存各规格的所属商品、描述、库存可用性与价格；金额单位为分。
/// 通过 items 导出，供模拟与约束模型共享使用。

let catalog = {
    'keyboard-linear-rgb': {
        'product_id': 'mechanical-keyboard',
        'description': '线性轴、RGB 背光',
        'available': true,
        'price': 12000,
    },
    'keyboard-clicky-rgb': {
        'product_id': 'mechanical-keyboard',
        'description': '段落轴、RGB 背光',
        'available': false,
        'price': 12500,
    },
    'keyboard-clicky-plain': {
        'product_id': 'mechanical-keyboard',
        'description': '段落轴、无背光',
        'available': true,
        'price': 12100,
    },
    'thermostat-google-home': {
        'product_id': 'smart-thermostat',
        'description': '兼容 Google Home 的温控器',
        'available': true,
        'price': 12100,
    },
}

return { 'items': catalog }
