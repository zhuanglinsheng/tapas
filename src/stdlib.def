/* Shared standard-environment manifest. Consumers define TAPAS_ROOT,
 * TAPAS_SESSION, TAPAS_PACKAGE, TAPAS_MEMBER, and TAPAS_TYPE. */

TAPAS_ROOT(print, gen_print, UNDEF_NPARAMS, "print(...AnyType) -> Nil")
TAPAS_ROOT(sprint, gen_sprint, UNDEF_NPARAMS, "sprint(...AnyType) -> Nil")
TAPAS_ROOT(len, gen_len, 1, "len(AnyType) -> Int")
TAPAS_ROOT(type, gen_type, 1, "type(AnyType) -> Int")
TAPAS_ROOT(copy, gen_copy, 1, "copy(AnyType) -> AnyType")
TAPAS_ROOT(identical, gen_identical, 2, "identical(AnyType, AnyType) -> Bool")
TAPAS_ROOT(clock, gen_clock, 0, "clock() -> Float")
TAPAS_ROOT(clock_ns, gen_clock_ns, 0, "clock_ns() -> Int")
TAPAS_ROOT(now, gen_now, 0, "now() -> Time")
TAPAS_ROOT(array, gen_array, 3, "array(Int, Int, List) -> RealArray")
TAPAS_ROOT(int, gen_int, 1, "int(AnyType) -> Int")
TAPAS_ROOT(float, gen_float, 1, "float(AnyType) -> Float")
TAPAS_ROOT(bool, gen_bool, 1, "bool(AnyType) -> Bool")
TAPAS_ROOT(str, gen_str, 1, "str(AnyType) -> String")
TAPAS_ROOT(list, gen_list, UNDEF_NPARAMS, "list(...AnyType) -> List")
TAPAS_ROOT(push, gen_push, 2, "push(List, AnyType) -> Nil")
TAPAS_ROOT(append, gen_append, 2, "append(AnyType, AnyType) -> Nil")
TAPAS_ROOT(insert, gen_insert, 3, "insert(List, Int, AnyType) -> Nil")
TAPAS_ROOT(pop, gen_pop, UNDEF_NPARAMS, "pop(List[, Int]) -> AnyType")
TAPAS_ROOT(delete, gen_delete, 2, "delete(AnyType, AnyType) -> Nil")
TAPAS_ROOT(idx, gen_idx, 2, "idx(AnyType, AnyType) -> AnyType")
TAPAS_ROOT(keys, gen_keys, 1, "keys(Dictionary) -> Iterator")
TAPAS_ROOT(dkeys, gen_keys, 1, "dkeys(Dictionary) -> Iterator")
TAPAS_ROOT(dvalues, gen_dvalues, 1, "dvalues(Dictionary) -> Iterator")
TAPAS_ROOT(union, gen_union, 2, "union(Dictionary, Dictionary) -> Dictionary")
TAPAS_ROOT(pair, gen_pair, 2, "pair(AnyType, AnyType) -> Pair")
TAPAS_ROOT(iter, gen_iter, UNDEF_NPARAMS, "iter(AnyType[, AnyType]) -> Iterator")
TAPAS_ROOT(sort, gen_sort, 1, "sort(List) -> List")

TAPAS_SESSION(__ls__, lib_ls, "__ls__([Library]) -> List<String>")
TAPAS_SESSION(__path__, lib_path, "__path__([Library]) -> List<String>")
TAPAS_SESSION(__param__, tf_param, "__param__(Int) -> AnyType")
TAPAS_SESSION(__nparam__, tf_nparam, "__nparam__() -> Int")
TAPAS_SESSION(__binary__, tf_binary, "__binary__([Library | Function]) -> Nil")

TAPAS_PACKAGE(dense)
TAPAS_MEMBER(dense, new, gen_array, 3, "new(Int, Int, List) -> RealArray")
TAPAS_MEMBER(dense, rows, gen_array_rows, 1, "rows(RealArray) -> Int")
TAPAS_MEMBER(dense, cols, gen_array_cols, 1, "cols(RealArray) -> Int")
TAPAS_MEMBER(dense, transpose, gen_array_transpose, 1, "transpose(RealArray) -> RealArray")

TAPAS_PACKAGE(time)
TAPAS_MEMBER(time, from_unix, gen_time_from_unix, 1, "from_unix(Int) -> Time")
TAPAS_MEMBER(time, unix, gen_time_unix, 1, "unix(Time) -> Int")
TAPAS_MEMBER(time, format, gen_time_format, 2, "format(Time, String) -> String")

TAPAS_PACKAGE(types)
TAPAS_TYPE(AnyType, ttype_builtin_any, "Type")
TAPAS_TYPE(Nil, ttype_builtin_nil, "Type")
TAPAS_TYPE(Bool, ttype_builtin_bool, "Type")
TAPAS_TYPE(Int, ttype_builtin_int, "Type")
TAPAS_TYPE(Float, ttype_builtin_float, "Type")
TAPAS_TYPE(String, ttype_builtin_string, "Type")
TAPAS_TYPE(List, ttype_builtin_list, "Type")
TAPAS_TYPE(Pair, ttype_builtin_pair, "Type")
TAPAS_TYPE(Dictionary, ttype_builtin_dictionary, "Type")
TAPAS_TYPE(Iterator, ttype_builtin_iterator, "Type")
TAPAS_TYPE(Function, ttype_builtin_function, "Type")
TAPAS_TYPE(Library, ttype_builtin_library, "Type")
TAPAS_TYPE(RealArray, ttype_builtin_real_array, "Type")
TAPAS_TYPE(BoolArray, ttype_builtin_bool_array, "Type")
TAPAS_TYPE(Time, ttype_builtin_time, "Type")
TAPAS_TYPE(Type, ttype_builtin_type, "Type")
TAPAS_MEMBER(types, make_type, gen_types_make_type, UNDEF_NPARAMS, "make_type(...Pair<String, Type>) -> Type")
TAPAS_MEMBER(types, union, gen_types_union, UNDEF_NPARAMS, "union(Type, Type, ...Type) -> Type")
TAPAS_MEMBER(types, list, gen_types_list, 1, "list(Type) -> Type")
TAPAS_MEMBER(types, pair, gen_types_pair, 2, "pair(Type, Type) -> Type")
TAPAS_MEMBER(types, dictionary, gen_types_dictionary, 2, "dictionary(Type, Type) -> Type")
TAPAS_MEMBER(types, of, gen_types_of, 1, "of(AnyType) -> Type")
TAPAS_MEMBER(types, matches, gen_types_matches, 2, "matches(AnyType, Type) -> Bool")
TAPAS_MEMBER(types, fields, gen_types_fields, 1, "fields(Type) -> Dictionary")
TAPAS_MEMBER(types, members, gen_types_members, 1, "members(Type) -> List")
TAPAS_MEMBER(types, base, gen_types_base, 1, "base(Type) -> Type")
TAPAS_MEMBER(types, parameters, gen_types_parameters, 1, "parameters(Type) -> Dictionary")
TAPAS_MEMBER(types, definition, gen_types_definition, 1, "definition(Type) -> Dictionary")

